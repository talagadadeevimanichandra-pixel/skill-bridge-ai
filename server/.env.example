# SkillBridge AI Backend Configuration

PORT=5000
NODE_ENV=development

# MongoDB Connection String
# Example Local: mongodb://localhost:27017/skillbridge_ai
# Example Atlas: mongodb+srv://<username>:<password>@<cluster-url>/skillbridge_ai?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/skillbridge_ai

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=30d

# Google Gemini AI API Key (Optional: Server uses built-in resilient AI engine if not set)
GEMINI_API_KEY=

# Client Application URL for CORS
CLIENT_URL=http://localhost:5173
