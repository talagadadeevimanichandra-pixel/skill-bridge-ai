# ==========================================
# SkillBridge AI - Environment Configuration
# ==========================================

# Backend Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection
# Local MongoDB: mongodb://localhost:27017/skillbridge_ai
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/skillbridge_ai?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/skillbridge_ai

# Authentication Secret (Use a strong random 256-bit string in production)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=30d

# Google Gemini AI API Key (Optional: Server uses built-in resilient AI heuristics if not provided)
GEMINI_API_KEY=

# Client URLs (for CORS configuration)
CLIENT_URL=http://localhost:5173

# Frontend Environment (Vite)
VITE_API_URL=/api
